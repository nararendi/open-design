{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "OD_WEB_OUTPUT_MODE= pnpm --filter @open-design/web build && node -e \"const fs=require('fs');if(fs.existsSync('apps/web/out')){fs.cpSync('apps/web/out','out',{recursive:true})}\"",
  "installCommand": "pnpm install",
  "outputDirectory": "apps/web/out",
  "framework": null,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
